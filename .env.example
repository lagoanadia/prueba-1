# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local a git.

# --- Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client ID) ---
# El mismo Client ID va dos veces:
#  - VITE_GOOGLE_CLIENT_ID lo lee el FRONTEND (Vite solo expone variables que empiezan por VITE_)
#  - GOOGLE_CLIENT_ID lo lee el BACKEND para comprobar que el token es para nuestra app
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Sesión ---
# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# Opcional. Modelos disponibles: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
