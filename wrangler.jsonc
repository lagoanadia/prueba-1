// Configuración del Worker de Cloudflare.
{
  // Debe coincidir con el nombre del Worker en el dashboard de Cloudflare.
  "name": "prueba-1",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Lo que genera `npm run build` (el frontend de React ya compilado).
    "directory": "./dist",
    // Cualquier URL desconocida devuelve index.html (lo normal en una SPA).
    "not_found_handling": "single-page-application",
    // Las URLs /api/* van SIEMPRE al Worker, nunca a los archivos estáticos.
    "run_worker_first": ["/api/*", "/assets/*"],
    // El Worker sirve /assets/* para devolver 404 (y no index.html) cuando piden un archivo de una versión anterior.
    "binding": "ASSETS"
  },
  // Variables NO secretas: van en el código para que ningún deploy las borre.
  // El Client ID de Google es público (también va dentro del JavaScript del frontend).
  "vars": {
    "GOOGLE_CLIENT_ID": "909832973896-6fin2g10n5847640kg9tn6fmrvdmiln5.apps.googleusercontent.com",
    "GROQ_MODEL": "openai/gpt-oss-120b"
  },
  // Los SECRETOS (SESSION_SECRET, GROQ_API_KEY) se ponen en el dashboard como tipo "Secret".
  // No borrar las variables que pongáis en el dashboard al desplegar.
  "keep_vars": true,
  // Base de datos clave-valor para las tareas. Sin "id": Cloudflare la crea sola en el primer deploy.
  "kv_namespaces": [{ "binding": "DATA" }],
  // Logs visibles en el dashboard (Workers > prueba-1 > Logs).
  "observability": { "enabled": true }
}
